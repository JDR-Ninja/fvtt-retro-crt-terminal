<section class="launcher-shell">
  <header>
    <span aria-hidden="true">&gt;</span>
    <h2>{{localize "RETRO_CRT_TERMINAL.Launcher.Access"}}</h2>
  </header>
  {{#if shared}}
    <button type="button" class="shared-session-banner {{#unless shared.controllerOnline}}is-offline{{/unless}}" data-action="joinShared">
      <i class="fa-solid fa-tower-broadcast" aria-hidden="true"></i>
      <span><strong>{{localize "RETRO_CRT_TERMINAL.Sync.Active"}}</strong><small>{{localize "RETRO_CRT_TERMINAL.Sync.ControlledBy"}} {{shared.controllerName}}</small></span>
      <i class="fa-solid fa-arrow-right-to-bracket" aria-hidden="true"></i>
    </button>
  {{/if}}
  {{#if empty}}
    <div class="empty-state launcher-empty-state">
      <p>{{localize "RETRO_CRT_TERMINAL.Launcher.Empty"}}</p>
    </div>
  {{else}}
    <ol class="launcher-list">
      {{#each terminals}}
        <li>
          <button type="button" class="launcher-open" data-action="open" data-uuid="{{uuid}}">
            <i class="{{icon}}" aria-hidden="true"></i>
            <span>{{label}}</span>
            {{#unless published}}<small>{{localize "RETRO_CRT_TERMINAL.Launcher.Unpublished"}}</small>{{/unless}}
          </button>
          {{#if canConfigure}}
            <div class="launcher-actions">
              {{#if isExample}}
                <button type="button" class="icon-button" data-action="updateExample" data-uuid="{{uuid}}" title="{{localize 'RETRO_CRT_TERMINAL.Example.Update'}}" aria-label="{{localize 'RETRO_CRT_TERMINAL.Example.Update'}}">
                  <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
                </button>
              {{/if}}
              <button type="button" class="icon-button" data-action="configure" data-uuid="{{uuid}}" title="{{localize 'RETRO_CRT_TERMINAL.Actions.Configure'}}" aria-label="{{localize 'RETRO_CRT_TERMINAL.Actions.Configure'}}">
                <i class="fa-solid fa-gears" aria-hidden="true"></i>
              </button>
            </div>
          {{/if}}
        </li>
      {{/each}}
    </ol>
  {{/if}}
  {{#if canCreateExample}}
    <div class="launcher-example-action">
      <p>{{localize "RETRO_CRT_TERMINAL.Launcher.EmptyGmHint"}}</p>
      <button type="button" data-action="createExample">
        <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
        {{localize "RETRO_CRT_TERMINAL.Example.Create"}}
      </button>
    </div>
  {{/if}}
  {{#if canRestoreExample}}
    <div class="launcher-example-action">
      <p>{{localize "RETRO_CRT_TERMINAL.Example.RestoreHint"}}</p>
      <button type="button" data-action="updateExample" data-uuid="{{exampleUuid}}">
        <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
        {{localize "RETRO_CRT_TERMINAL.Example.Restore"}}
      </button>
    </div>
  {{/if}}
</section>
