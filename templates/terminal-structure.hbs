<section class="structure-shell">
  <header class="structure-heading">
    <div>
      <h2>{{journal.name}}</h2>
      <p>{{localize "RETRO_CRT_TERMINAL.Structure.Hint"}}</p>
    </div>
  </header>

  {{#if empty}}
    <p class="empty-state">{{localize "RETRO_CRT_TERMINAL.Structure.Empty"}}</p>
  {{else}}
    <div class="structure-table-wrap">
      <table class="structure-table">
        <thead><tr><th>{{localize "RETRO_CRT_TERMINAL.Fields.Page"}}</th><th>{{localize "RETRO_CRT_TERMINAL.Fields.Parent"}}</th><th>{{localize "RETRO_CRT_TERMINAL.Fields.Release"}}</th><th>{{localize "RETRO_CRT_TERMINAL.Fields.Actions"}}</th></tr></thead>
        <tbody>
          {{#each pages}}
            <tr>
              <td><strong>{{label}}</strong><small>{{pageId}}</small></td>
              <td>{{parent}}</td>
              <td><span class="state-pill is-{{visibility}}">{{visibilityLabel}}</span><span class="state-pill is-{{access}}">{{accessLabel}}</span></td>
              <td class="row-actions">
                <button type="button" data-action="open" data-uuid="{{uuid}}" title="{{localize 'RETRO_CRT_TERMINAL.Actions.Open'}}"><i class="fa-solid fa-play"></i></button>
                <button type="button" data-action="edit" data-uuid="{{uuid}}" title="{{localize 'RETRO_CRT_TERMINAL.Actions.Edit'}}"><i class="fa-solid fa-pen"></i></button>
                <button type="button" data-action="visibility" data-uuid="{{uuid}}" title="{{localize 'RETRO_CRT_TERMINAL.Actions.ToggleVisibility'}}"><i class="fa-solid {{#if isHidden}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></button>
                <button type="button" data-action="access" data-uuid="{{uuid}}" title="{{localize 'RETRO_CRT_TERMINAL.Actions.ToggleLock'}}"><i class="fa-solid {{#if isLocked}}fa-lock-open{{else}}fa-lock{{/if}}"></i></button>
                <button type="button" data-action="copyUuid" data-uuid="{{uuid}}" title="{{localize 'RETRO_CRT_TERMINAL.Actions.CopyUuid'}}"><i class="fa-solid fa-copy"></i></button>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{/if}}

  {{#if issues.length}}
    <section class="validation-issues">
      <h3>{{localize "RETRO_CRT_TERMINAL.Diagnostics.Validation"}}</h3>
      <ul>{{#each issues}}<li class="is-{{severity}}"><strong>{{pageName}}</strong> {{message}}{{#if line}} (L{{line}}){{/if}}</li>{{/each}}</ul>
    </section>
  {{/if}}
</section>
